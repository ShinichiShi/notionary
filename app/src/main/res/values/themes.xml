<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.Notionary" parent="Theme.Material3.DayNight">
        <!-- Use default Material 3 colors -->
    </style>

    <!-- Legacy theme name for backward compatibility -->
    <style name="Theme.CollabProductivity" parent="Theme.Notionary" />

    <!-- Theme for activities with custom Toolbar (no ActionBar) -->
    <style name="Theme.Notionary.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Dialog Theme -->
    <style name="Theme.Notionary.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowSoftInputMode">stateUnspecified|adjustPan</item>
    </style>
</resources>
